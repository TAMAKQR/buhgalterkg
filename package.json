{
    "name": "telegram-hotel-ops",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "node scripts/run_next_local.mjs dev",
        "build": "prisma generate && next build",
        "postbuild": "node scripts/render_migrate_if_needed.mjs",
        "render:build": "npm run build",
        "start": "next start",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm run lint && npm run prisma:validate",
        "prisma:generate": "node scripts/run_prisma_local.mjs generate",
        "prisma:validate": "node scripts/run_prisma_local.mjs validate",
        "prisma:push": "node scripts/run_prisma_local.mjs db push",
        "prisma:migrate": "node scripts/run_prisma_local.mjs migrate dev",
        "prisma:deploy:local": "node scripts/run_prisma_local.mjs migrate deploy",
        "prisma:studio": "node scripts/run_prisma_local.mjs studio",
        "prisma:seed": "node scripts/run_prisma_local.mjs db seed"
    },
    "dependencies": {
        "@ducanh2912/next-pwa": "^10.2.9",
        "@hookform/resolvers": "^3.5.0",
        "@prisma/client": "^5.16.1",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "date-fns": "^3.6.0",
        "jsqr": "^1.4.0",
        "lucide-react": "^0.462.0",
        "next": "15.5.20",
        "qrcode": "^1.5.4",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-hook-form": "^7.53.0",
        "swr": "^2.2.5",
        "tailwind-merge": "^2.5.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^20.14.15",
        "@types/qrcode": "^1.5.6",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.0",
        "eslint-config-next": "15.5.20",
        "postcss": "^8.5.19",
        "prisma": "^5.16.1",
        "tailwindcss": "^3.4.10",
        "typescript": "^5.6.2"
    },
    "prisma": {
        "seed": "node prisma/seed.mjs"
    },
    "engines": {
        "node": ">=20 <23"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5",
        "postcss": "^8.5.19"
    }
}
