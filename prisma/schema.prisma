generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String            @id @default(cuid())
  telegramId  String            @unique
  displayName String
  role        UserRole          @default(MANAGER)
  avatarUrl   String?
  loginName   String?           @unique @map("login_name")
  loginHash   String?           @map("login_hash")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  ledger      CashEntry[]
  assignments HotelAssignment[]
  shifts      Shift[]           @relation("ShiftManager")
  receivedHandovers Shift[]     @relation("ShiftHandoverRecipient")
  verifiedGuestProfiles GuestProfile[] @relation("GuestProfileVerifiedBy")
  guestProfileAuditLogs GuestProfileAuditLog[]
}

model Hotel {
  id              String            @id @default(cuid())
  name            String
  address         String
  city            String?
  country         String            @default("KG")
  timezone        String            @default("Asia/Bishkek")
  currency        String            @default("KGS")
  usesExtranets   Boolean           @default(false) @map("uses_extranets")
  extranetNames   String[]          @default([]) @map("extranet_names")
  hasMealPlan     Boolean           @default(false) @map("has_meal_plan")
  allowGroupStays Boolean           @default(true) @map("allow_group_stays")
  allowPostpaidStays Boolean        @default(false) @map("allow_postpaid_stays")
  allowOnlinePayments Boolean       @default(true) @map("allow_online_payments")
  guestQrEnabled  Boolean           @default(true) @map("guest_qr_enabled")
  showInGuestListing Boolean        @default(true) @map("show_in_guest_listing")
  guestDescription String?          @map("guest_description")
  guestAmenities  String[]          @default([]) @map("guest_amenities")
  guestPhotoUrls  String[]          @default([]) @map("guest_photo_urls")
  guestMapUrl     String?           @map("guest_map_url")
  financialCycleStartDay Int        @default(1) @map("financial_cycle_start_day")
  managerSharePct Int?              @map("manager_share_pct")
  cleaningChatId  String?           @map("cleaning_chat_id")
  monthlyPayrollCost   Int          @default(0) @map("monthly_payroll_cost")
  monthlyRentCost      Int          @default(0) @map("monthly_rent_cost")
  monthlyUtilitiesCost Int          @default(0) @map("monthly_utilities_cost")
  monthlySuppliesCost  Int          @default(0) @map("monthly_supplies_cost")
  monthlyOtherCost     Int          @default(0) @map("monthly_other_cost")
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ledger          CashEntry[]
  assignments     HotelAssignment[]
  guestProfiles   GuestProfile[]
  verifiedGuestProfiles GuestProfile[] @relation("GuestProfileVerifiedHotel")
  guestProfileAuditLogs GuestProfileAuditLog[]
  guestQrTokens   GuestQrToken[]
  rooms           Room[]
  stays           RoomStay[]
  shifts          Shift[]
  bonusTiers      BonusTier[]
  expenseCategories ExpenseCategory[]
  roomCostCategories RoomCostCategory[]
  plannedCostItems  HotelPlannedCostItem[]
  employees         HotelEmployee[]
}

model HotelEmployee {
  id          String    @id @default(cuid())
  hotelId     String    @map("hotel_id")
  fullName    String    @map("full_name")
  position    String
  payType     String    @default("MONTHLY") @map("pay_type")
  payAmount   Int       @default(0) @map("pay_amount")
  turnoverThreshold Int? @map("turnover_threshold")
  highPayAmount Int? @map("high_pay_amount")
  isActive    Boolean   @default(true) @map("is_active")
  hiredAt     DateTime? @map("hired_at")
  dismissedAt DateTime? @map("dismissed_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  payouts     CashEntry[]

  @@index([hotelId, isActive])
  @@map("hotel_employees")
}

model HotelPlannedCostItem {
  id            String   @id @default(cuid())
  hotelId       String   @map("hotel_id")
  name          String
  monthlyAmount Int      @default(0) @map("monthly_amount")
  kind          String   @default("GENERAL")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, sortOrder])
  @@map("hotel_planned_cost_items")
}

model GuestProfile {
  id             String         @id @default(cuid())
  hotelId        String?        @map("hotel_id")
  fullName       String         @map("full_name")
  phone          String?
  telegramId     String?        @map("telegram_id")
  documentNumber String?        @map("document_number")
  verificationStatus GuestVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt     DateTime?      @map("verified_at")
  verifiedById   String?        @map("verified_by_id")
  verifiedHotelId String?       @map("verified_hotel_id")
  consentAcceptedAt DateTime?   @map("consent_accepted_at")
  consentVersion String?        @map("consent_version")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  hotel          Hotel?         @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  verifiedBy     User?          @relation("GuestProfileVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedHotel  Hotel?         @relation("GuestProfileVerifiedHotel", fields: [verifiedHotelId], references: [id], onDelete: SetNull)
  qrTokens       GuestQrToken[]
  stays          RoomStay[]
  auditLogs      GuestProfileAuditLog[]

  @@index([hotelId])
  @@index([phone])
  @@index([telegramId])
  @@unique([hotelId, telegramId])
  @@index([verificationStatus])
  @@index([verifiedById])
  @@index([verifiedHotelId])
  @@index([consentAcceptedAt])
}

model GuestProfileAuditLog {
  id             String                  @id @default(cuid())
  guestProfileId String                  @map("guest_profile_id")
  hotelId        String?                 @map("hotel_id")
  actorUserId    String?                 @map("actor_user_id")
  actorType      GuestProfileActorType   @default(SYSTEM) @map("actor_type")
  actorLabel     String?                 @map("actor_label")
  action         GuestProfileAuditAction
  changedFields  String[]                @default([]) @map("changed_fields")
  before         Json?
  after          Json?
  createdAt      DateTime                @default(now()) @map("created_at")
  guestProfile   GuestProfile            @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)
  hotel          Hotel?                  @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  actorUser      User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([guestProfileId, createdAt])
  @@index([hotelId])
  @@index([actorUserId])
  @@index([action])
}

model GuestQrToken {
  id             String       @id @default(cuid())
  guestProfileId String       @map("guest_profile_id")
  hotelId        String?      @map("hotel_id")
  code           String       @unique
  expiresAt      DateTime?    @map("expires_at")
  lastScannedAt  DateTime?    @map("last_scanned_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  guestProfile   GuestProfile @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)
  hotel          Hotel?       @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([guestProfileId])
  @@index([hotelId])
  @@index([code])
}

model HotelAssignment {
  id        String   @id @default(cuid())
  hotelId   String
  userId    String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Legacy compatibility only. New and reset PIN values are stored in pinHash.
  pinCode   String?  @map("pin_code") @db.VarChar(6)
  pinHash   String?  @map("pin_hash")
  shiftPayAmount Int? @map("shift_pay_amount")
  revenueSharePct Int? @map("revenue_share_pct")
  canEditBookings Boolean @default(false) @map("can_edit_bookings")
  canEditStayPayments Boolean @default(false) @map("can_edit_stay_payments")
  canCancelBookings Boolean @default(false) @map("can_cancel_bookings")
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([hotelId, userId])
  @@index([hotelId, pinCode])
}

model Room {
  id            String     @id @default(cuid())
  hotelId       String
  label         String
  floor         String?
  isActive      Boolean    @default(true)
  status        RoomStatus @default(AVAILABLE)
  currentStayId String?    @unique
  notes         String?
  createdAt     DateTime   @default(now())
  archivedAt    DateTime?  @map("archived_at")
  activityTrackedFrom DateTime @default(now()) @map("activity_tracking_started_at")
  nightlyVariableCost Int      @default(0) @map("nightly_variable_cost")
  breakfastCost       Int      @default(0) @map("breakfast_cost")
  lunchCost           Int      @default(0) @map("lunch_cost")
  dinnerCost          Int      @default(0) @map("dinner_cost")
  costCategoryId      String?  @map("cost_category_id")
  updatedAt     DateTime   @updatedAt
  currentStay   RoomStay?  @relation("RoomCurrentStay", fields: [currentStayId], references: [id])
  hotel         Hotel      @relation(fields: [hotelId], references: [id])
  stays         RoomStay[] @relation("RoomStayHistory")
  transfersFrom StayTransfer[] @relation("StayTransferFromRoom")
  transfersTo   StayTransfer[] @relation("StayTransferToRoom")
  ledgerEntries CashEntry[]
  activityPeriods RoomActivityPeriod[]
  costItems      RoomCostItem[]
  costCategory   RoomCostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  @@unique([hotelId, label])
  @@index([hotelId, archivedAt])
  @@index([costCategoryId])
}

model RoomCostItem {
  id            String   @id @default(cuid())
  roomId        String?  @map("room_id")
  categoryId    String?  @map("category_id")
  name          String
  quantityMilli Int      @default(1000) @map("quantity_milli")
  unitPrice     Int      @default(0) @map("unit_price")
  mealPlanCode  String?  @map("meal_plan_code")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  category      RoomCostCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([roomId, sortOrder])
  @@index([categoryId, sortOrder])
  @@map("room_cost_items")
}

model RoomCostCategory {
  id        String   @id @default(cuid())
  hotelId   String   @map("hotel_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms     Room[]
  costItems RoomCostItem[]

  @@unique([hotelId, name])
  @@index([hotelId])
  @@map("room_cost_categories")
}

model RoomActivityPeriod {
  id         String    @id @default(cuid())
  roomId     String    @map("room_id")
  activeFrom DateTime  @map("active_from")
  activeTo   DateTime? @map("active_to")
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, activeFrom, activeTo])
  @@map("room_activity_periods")
}

model RoomStay {
  id                String         @id @default(cuid())
  roomId            String
  hotelId           String
  shiftId           String?
  guestProfileId    String?        @map("guest_profile_id")
  guestName         String?
  guestPhone        String?        @map("guest_phone")
  companyName       String?        @map("company_name")
  bookingSource     String?        @map("booking_source")
  bookingNumber     String?        @map("booking_number")
  scheduledCheckIn  DateTime
  scheduledCheckOut DateTime
  actualCheckIn     DateTime?
  actualCheckOut    DateTime?
  status            StayStatus     @default(SCHEDULED)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  amountPaid        Int?
  totalAmount       Int?           @map("total_amount")
  paymentMethod     PaymentMethod?
  cashPaid          Int            @default(0)
  cardPaid          Int            @default(0)
  onlinePaid        Int            @default(0) @map("online_paid")
  tariffPending     Boolean        @default(false) @map("tariff_pending")
  mealPlan          String[]       @default([]) @map("meal_plan")
  groupRef          String?        @map("group_ref")
  cancellationPaymentAction CancellationPaymentAction? @map("cancellation_payment_action")
  cancellationAmount Int?          @map("cancellation_amount")
  cancelledAt       DateTime?      @map("cancelled_at")
  cancelledById     String?        @map("cancelled_by_id")
  ledgerEntries     CashEntry[]
  currentRoom       Room?          @relation("RoomCurrentStay")
  guestProfile      GuestProfile?  @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  hotel             Hotel          @relation(fields: [hotelId], references: [id])
  room              Room           @relation("RoomStayHistory", fields: [roomId], references: [id])
  shift             Shift?         @relation(fields: [shiftId], references: [id])
  transfers         StayTransfer[]

  @@index([hotelId, groupRef])
  @@index([guestProfileId])
  @@index([roomId, status, scheduledCheckIn, scheduledCheckOut])
  @@index([hotelId, status, scheduledCheckIn])
  @@index([shiftId])
}

model StayTransfer {
  id         String   @id @default(cuid())
  stayId      String   @map("stay_id")
  fromRoomId  String   @map("from_room_id")
  toRoomId    String   @map("to_room_id")
  shiftId     String?  @map("shift_id")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  stay        RoomStay @relation(fields: [stayId], references: [id], onDelete: Cascade)
  fromRoom    Room     @relation("StayTransferFromRoom", fields: [fromRoomId], references: [id])
  toRoom      Room     @relation("StayTransferToRoom", fields: [toRoomId], references: [id])
  shift       Shift?   @relation(fields: [shiftId], references: [id])

  @@index([stayId, createdAt])
  @@index([fromRoomId, createdAt])
  @@index([toRoomId, createdAt])
}

model Shift {
  id           String      @id @default(cuid())
  hotelId      String
  managerId    String
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  openingCash  Int
  openingCashUsd Int       @default(0) @map("opening_cash_usd")
  closingCash  Int?
  closingCashUsd Int?      @map("closing_cash_usd")
  handoverCash Int?
  handoverCashUsd Int?     @map("handover_cash_usd")
  openingNote  String?
  closingNote  String?
  handoverNote String?
  handoverRecipientId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  number       Int         @default(0)
  ledger       CashEntry[]
  stays        RoomStay[]
  transfers    StayTransfer[]
  hotel        Hotel       @relation(fields: [hotelId], references: [id])
  manager      User        @relation("ShiftManager", fields: [managerId], references: [id])
  handoverRecipient   User?      @relation("ShiftHandoverRecipient", fields: [handoverRecipientId], references: [id])

  @@unique([hotelId, number])
  @@index([hotelId, status])
  @@index([hotelId, openedAt])
}

model CashEntry {
  id         String          @id @default(cuid())
  shiftId    String?
  stayId     String?         @map("stay_id")
  roomId     String?         @map("room_id")
  hotelId    String
  managerId  String?
  categoryId String?         @map("expense_category_id")
  employeeId String?         @map("employee_id")
  entryType  LedgerEntryType
  method     PaymentMethod
  amount     Int
  originalAmount Int?      @map("original_amount")
  originalCurrency String  @default("KGS") @map("original_currency")
  exchangeRate Int?        @map("exchange_rate")
  note       String?
  meta       Json?
  clientOperationId String?       @unique @map("client_operation_id")
  recordedAt DateTime        @default(now())
  expenseCategory ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  employee   HotelEmployee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  stay       RoomStay?       @relation(fields: [stayId], references: [id], onDelete: SetNull)
  room       Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  hotel      Hotel           @relation(fields: [hotelId], references: [id])
  manager    User?           @relation(fields: [managerId], references: [id])
  shift      Shift?          @relation(fields: [shiftId], references: [id])

  @@index([stayId])
  @@index([roomId, recordedAt])
  @@index([hotelId, recordedAt])
  @@index([employeeId, recordedAt])
  @@index([shiftId, recordedAt])
  @@index([hotelId, entryType, recordedAt])
}

model RequestRateLimit {
  keyHash         String   @id @map("key_hash") @db.VarChar(64)
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now()) @map("window_started_at")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("request_rate_limits")
}

model ExpenseCategory {
  id        String      @id @default(cuid())
  hotelId   String
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  hotel     Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  entries   CashEntry[]

  @@unique([hotelId, name])
  @@index([hotelId])
}


enum UserRole {
  ADMIN
  MANAGER
  OBSERVER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
}

enum LedgerEntryType {
  CASH_IN
  CASH_OUT
  MANAGER_PAYOUT
  ADJUSTMENT
}

enum StayStatus {
  SCHEDULED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  HOLD
}

enum CancellationPaymentAction {
  REFUND
  RETAIN
}

enum GuestVerificationStatus {
  PENDING
  VERIFIED
  NEEDS_REVIEW
}

enum GuestProfileActorType {
  GUEST
  MANAGER
  ADMIN
  SYSTEM
}

enum GuestProfileAuditAction {
  PROFILE_CREATED
  PROFILE_UPDATED
  DOCUMENT_VERIFIED
  CONSENT_ACCEPTED
}

model BonusTier {
  id        String   @id @default(cuid())
  hotelId   String
  threshold Int      // cash threshold in smallest unit (tiyin/tenge)
  bonus     Int      // fixed bonus amount in smallest unit
  bonusPct  Int?     @map("bonus_pct") // alternative: percentage * 100 (e.g. 500 = 5%)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([hotelId, threshold])
  @@index([hotelId])
}

