# Required for Prisma connection (Render PostgreSQL URL)
DATABASE_URL="postgresql://user:pass@host:5432/buhgaler"

# Optional diagnostics. SQL query logging is intentionally off by default.
PRISMA_LOG_QUERIES="false"

# Telegram bot token (BotFather)
TELEGRAM_BOT_TOKEN="123456:ABCDEF"
GUEST_TELEGRAM_BOT_TOKEN="123456:GUESTPASS"
GUEST_TELEGRAM_WEBAPP_URL="https://your-domain.com/guest"

# Manual admin web login
# Password must be at least ADMIN_PASSWORD_MIN_LENGTH chars and contain letters + digits
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="change-me"
ADMIN_DISPLAY_NAME="Web Admin"
# Generate a unique 32+ byte value, for example: openssl rand -base64 48
ADMIN_SESSION_SECRET="<generate-a-unique-random-secret>"
ADMIN_SESSION_TTL_MINUTES="720"
ADMIN_PASSWORD_MIN_LENGTH="10"
ADMIN_LOGIN_ATTEMPTS="5"
ADMIN_LOGIN_WINDOW_MINUTES="15"
ADMIN_TELEGRAM_CHAT_ID="123456789"

# Optional AI analysis
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"

# Configure the same values as secret_token when registering Telegram webhooks.
TELEGRAM_WEBHOOK_SECRET="<generate-a-unique-32-byte-secret>"
GUEST_TELEGRAM_WEBHOOK_SECRET="<generate-a-different-32-byte-secret>"
EXELY_AUTH_URL=https://connect.hopenapi.com/auth/token
EXELY_API_URL=https://connect.hopenapi.com
# Отдельный стабильный ключ для шифрования client_secret интеграций в БД.
# Если не задан, используется ADMIN_SESSION_SECRET.
INTEGRATION_CREDENTIALS_KEY="<generate-a-unique-random-secret-of-at-least-32-bytes>"
